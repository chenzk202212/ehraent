# Copy to EhrAgent/ehragent/.env and fill in your keys.
# For GPT via AIHubMix (optional):
#   OPENAI_API_KEY=sk-...
#   OPENAI_BASE_URL=https://aihubmix.com/v1
#   HTTP_PROXY=http://127.0.0.1:7890
#   HTTPS_PROXY=http://127.0.0.1:7890
#
# For local Qwen (vLLM):
#   OPENAI_BASE_URL=http://127.0.0.1:8012/v1
#   OPENAI_API_KEY=EMPTY

export EHRAGENT_ROOT="$(pwd)/EhrAgent"
export EHRAGENT_DATA_ROOT="$(pwd)/EhrAgent/ehrsql-ehragent"
export EHRAGENT_API_TYPE=openai
